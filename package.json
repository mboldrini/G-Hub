{
  "name": "prdashboard-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "Automated tests for PrDashboard web frontend",
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest run Tests/Web/unit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:syntax": "node Tests/validate-js-syntax.cjs",
    "validate": "npm run test:syntax && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/ui": "^1.0.0",
    "c8": "^9.0.0",
    "jsdom": "^23.0.0",
    "playwright": "^1.64.1",
    "vitest": "^1.0.0"
  }
}
