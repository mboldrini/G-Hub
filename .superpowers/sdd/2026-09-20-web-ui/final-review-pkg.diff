@@ -0,0 +1,128 @@
+using PrDashboard.Logic;
+using PrDashboard.Models;
+
+namespace PrDashboard.Web;
+
+public class PrsApiResponse
+{
+    public string Login { get; set; } = "";
+    public string UpdatedAt { get; set; } = "";
+    public int IntervalSeconds { get; set; }
+    public bool IsLoading { get; set; }
+    public string? Error { get; set; }
+    public List<PrDto> MyPrs { get; set; } = [];
+    public List<ReviewPrDto> ReviewPrs { get; set; } = [];
+    public List<MergedPrDto> MergedPrs { get; set; } = [];
+}
+
+public class PrDto
+{
+    public string Repo { get; set; } = "";
+    public int Number { get; set; }
+    public string Title { get; set; } = "";
+    public string Url { get; set; } = "";
+    public bool IsDraft { get; set; }
+    public string Author { get; set; } = "";
+    public string AgeAgo { get; set; } = "";
+    public string Urgency { get; set; } = "";
+    public bool NeedsAction { get; set; }
+    public string ReviewState { get; set; } = "";
+    public string? ReviewedBy { get; set; }
+    public string? ReviewedAgo { get; set; }
+    public List<string> PendingReviewers { get; set; } = [];
+    public string CiState { get; set; } = "";
+    public string? FailingCheck { get; set; }
+    public string CommentState { get; set; } = "";
+    public string? LastCommentBy { get; set; }
+    public string? LastCommentAgo { get; set; }
+    public int OpenThreads { get; set; }
+    public string MergeState { get; set; } = "";
+}
+
+public class ReviewPrDto
+{
+    public string Repo { get; set; } = "";
+    public int Number { get; set; }
+    public string Title { get; set; } = "";
+    public string Url { get; set; } = "";
+    public string Author { get; set; } = "";
+    public string AgeAgo { get; set; } = "";
+    public string CiState { get; set; } = "";
+    public string? FailingCheck { get; set; }
+    public string? LastCommentBy { get; set; }
+    public string? LastCommentAgo { get; set; }
+}
+
+public class MergedPrDto
+{
+    public string Repo { get; set; } = "";
+    public int Number { get; set; }
+    public string Title { get; set; } = "";
+    public string Url { get; set; } = "";
+    public string MergedAgo { get; set; } = "";
+    public string Duration { get; set; } = "";
+}
+
+public static class PrsApiDtos
+{
+    public static PrDto MapMyPr(PullRequest pr, DateTimeOffset now)
+    {
+        var s = pr.Status;
+        return new PrDto
+        {
+            Repo = pr.Repo,
+            Number = pr.Number,
+            Title = pr.Title,
+            Url = pr.Url,
+            IsDraft = pr.IsDraft,
+            Author = pr.Author ?? "",
+            AgeAgo = TimeFormatter.Ago(pr.CreatedAt, now),
+            Urgency = s?.Urgency.ToString() ?? "Normal",
+            NeedsAction = s?.NeedsMyAction ?? false,
+            ReviewState = s?.Review.State.ToString() ?? "None",
+            ReviewedBy = s?.Review.Reviewer,
+            ReviewedAgo = s?.Review.Since is { } rs ? TimeFormatter.Duration(rs) + " atrás" : null,
+            PendingReviewers = s?.Review.PendingReviewers ?? [],
+            CiState = s?.Ci.State.ToString() ?? "None",
+            FailingCheck = s?.Ci.FailingCheck,
+            CommentState = s?.Comment.State.ToString() ?? "Quiet",
+            LastCommentBy = s?.Comment.LastAuthor,
+            LastCommentAgo = s?.Comment.Since is { } cs ? TimeFormatter.Duration(cs) + " atrás" : null,
+            OpenThreads = s?.Comment.OpenThreads ?? 0,
+            MergeState = s?.Merge.State.ToString() ?? "Unknown",
+        };
+    }
+
+    public static ReviewPrDto MapReviewPr(PullRequest pr, DateTimeOffset now)
+    {
+        var s = pr.Status;
+        var lastComment = pr.RecentComments
+            .Where(c => c.Author != (pr.Author ?? "") && !PrAnalyzer.IsBot(c.Author))
+            .OrderByDescending(c => c.CreatedAt)
+            .FirstOrDefault();
+
+        return new ReviewPrDto
+        {
+            Repo = pr.Repo,
+            Number = pr.Number,
+            Title = pr.Title,
+            Url = pr.Url,
+            Author = pr.Author ?? "",
+            AgeAgo = TimeFormatter.Ago(pr.CreatedAt, now),
+            CiState = s?.Ci.State.ToString() ?? "None",
+            FailingCheck = s?.Ci.FailingCheck,
+            LastCommentBy = lastComment?.Author,
+            LastCommentAgo = lastComment is not null ? TimeFormatter.Ago(lastComment.CreatedAt, now) : null,
+        };
+    }
+
+    public static MergedPrDto MapMergedPr(MergedPr pr, DateTimeOffset now) => new()
+    {
+        Repo = pr.Repo,
+        Number = pr.Number,
+        Title = pr.Title,
+        Url = pr.Url,
+        MergedAgo = TimeFormatter.Ago(pr.MergedAt, now),
+        Duration = TimeFormatter.Duration(pr.MergedAt - pr.CreatedAt),
+    };
+}
diff --git a/PrDashboard/Web/PrsDataService.cs b/PrDashboard/Web/PrsDataService.cs
new file mode 100644
index 0000000..d0a2a97
--- /dev/null
+++ b/PrDashboard/Web/PrsDataService.cs
@@ -0,0 +1,102 @@
+using PrDashboard.GitHub;
+using PrDashboard.Logic;
+using PrDashboard.Models;
+using PrDashboard.UI;
+
+namespace PrDashboard.Web;
+
+public class PrsDataService(GhApiClient client, string login, AppConfig config, bool demoMode)
+{
+    private volatile PrsApiResponse? _cached;
+
+    public PrsApiResponse? Cached => _cached;
+
+    public async Task InitAsync(CancellationToken ct)
+    {
+        if (demoMode)
+        {
+            _cached = BuildDemoResponse();
+            return;
+        }
+        await RefreshAsync(ct);
+    }
+
+    public void StartBackgroundRefresh(CancellationToken ct)
+    {
+        if (demoMode) return;
+        _ = Task.Run(async () =>
+        {
+            while (!ct.IsCancellationRequested)
+            {
+                try { await Task.Delay(TimeSpan.FromSeconds(config.IntervalSeconds), ct); }
+                catch (OperationCanceledException) { return; }
+                await RefreshAsync(ct);
+            }
+        }, ct);
+    }
+
+    private async Task RefreshAsync(CancellationToken ct)
+    {
+        try
+        {
+            var myPrs = await client.FetchMyOpenPrsAsync(login, config, ct);
+            var reviewPrs = await client.FetchReviewRequestedPrsAsync(login, config, ct);
+            var mergedPrs = await client.FetchMergedPrsAsync(login, config.HistoryDays, ct);
+
+            var myKeys = myPrs.Select(p => $"{p.Repo}#{p.Number}").ToHashSet();
+            reviewPrs = reviewPrs
+                .Where(p => !myKeys.Contains($"{p.Repo}#{p.Number}"))
+                .Where(p => !PrAnalyzer.IsBot(p.Author ?? ""))
+                .ToList();
+
+            var now = DateTimeOffset.UtcNow;
+            foreach (var pr in myPrs.Concat(reviewPrs))
+                pr.Status = PrAnalyzer.Analyze(pr, login, now);
+
+            _cached = new PrsApiResponse
+            {
+                Login = login,
+                UpdatedAt = now.ToLocalTime().ToString("HH:mm:ss"),
+                IntervalSeconds = config.IntervalSeconds,
+                MyPrs = myPrs.Select(p => PrsApiDtos.MapMyPr(p, now)).ToList(),
+                ReviewPrs = reviewPrs.Select(p => PrsApiDtos.MapReviewPr(p, now)).ToList(),
+                MergedPrs = mergedPrs.Select(p => PrsApiDtos.MapMergedPr(p, now)).ToList(),
+            };
+        }
+        catch (OperationCanceledException) { throw; }
+        catch (Exception ex)
+        {
+            var prev = _cached;
+            _cached = new PrsApiResponse
+            {
+                Login = prev?.Login ?? login,
+                UpdatedAt = prev?.UpdatedAt ?? "",
+                IntervalSeconds = config.IntervalSeconds,
+                Error = ex.Message,
+                MyPrs = prev?.MyPrs ?? [],
+                ReviewPrs = prev?.ReviewPrs ?? [],
+                MergedPrs = prev?.MergedPrs ?? [],
+            };
+        }
+    }
+
+    private PrsApiResponse BuildDemoResponse()
+    {
+        var (myPrs, reviewPrs, mergedPrs) = DemoData.Generate();
+        var now = DateTimeOffset.UtcNow;
+        foreach (var pr in myPrs.Concat(reviewPrs))
+            pr.Status = PrAnalyzer.Analyze(pr, "demo-user", now);
+
+        return new PrsApiResponse
+        {
+            Login = "demo-user",
+            UpdatedAt = now.ToLocalTime().ToString("HH:mm:ss"),
+            IntervalSeconds = config.IntervalSeconds,
+            MyPrs = myPrs.Select(p => PrsApiDtos.MapMyPr(p, now)).ToList(),
+            ReviewPrs = reviewPrs
+                .Where(p => !PrAnalyzer.IsBot(p.Author ?? ""))
+                .Select(p => PrsApiDtos.MapReviewPr(p, now)).ToList(),
+            MergedPrs = mergedPrs.Select(p => PrsApiDtos.MapMergedPr(p, now)).ToList(),
+        };
+    }
+}
