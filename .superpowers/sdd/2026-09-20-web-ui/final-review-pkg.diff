+        .scard{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:14px}
+        .mrow{display:flex;gap:12px;padding:7px 0;border-bottom:1px solid var(--bg3);font-size:13px;align-items:baseline}
+        .mrow:last-child{border-bottom:none}
+        .mrepo{color:var(--muted);min-width:150px;font-size:12px;flex-shrink:0}
+        .mrow a{color:var(--text);text-decoration:none}
+        .mrow a:hover{color:var(--blue)}
+        .mmeta{color:var(--muted);font-size:12px;margin-left:auto;white-space:nowrap;flex-shrink:0}
+        </style>
+        </head>
+        <body>
+        <header>
+          <div class="hl">
+            <span class="dot" id="dot">●</span>
+            <h1>Meus PRs</h1>
+            <span class="counts" id="counts"></span>
+          </div>
+          <div class="hr">
+            <span id="rlabel"></span>
+            <button class="rbtn" onclick="manual()">↻ Atualizar</button>
+          </div>
+        </header>
+        <main>
+          <div class="ebanner" id="err"></div>
+          <div class="empty" id="loading">Carregando...</div>
+          <div id="content" style="display:none">
+            <section id="s-my"></section>
+            <section id="s-rev"></section>
+            <section id="s-mrg"></section>
+          </div>
+        </main>
+        <script>
+        let ivSecs=300,cd=0,tmr=null;
+        const uc={CiFailing:'ci',ChangesRequested:'ch',CommentsPending:'cp',AwaitingReview:'ar',Approved:'ap',Normal:''};
+        function e(s){return(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
+        function badge(cls,icon,text){return text?`<span class="b ${cls}">${icon} ${e(text)}</span>`:''}
+        function reviewBadge(p){
+          if(p.reviewState==='Approved')return badge('bg','✓',`${p.reviewedBy} · ${p.reviewedAgo}`);
+          if(p.reviewState==='ChangesRequested')return badge('br','✗','mudanças pedidas');
+          if(p.reviewState==='Pending')return badge('bb','⏳',p.pendingReviewers?.join(', ')||'aguardando');
+          return badge('bx','','sem review');
+        }
+        function ciBadge(ciState,failingCheck){
+          if(ciState==='Passing')return badge('bg','✓','CI');
+          if(ciState==='Failing')return badge('br','✗',failingCheck||'CI');
+          if(ciState==='Pending')return badge('by','⏳','CI');
+          return '';
+        }
+        function commentBadge(p){
+          if(p.commentState==='New'){
+            const t=p.openThreads>0?` · ${p.openThreads} threads`:'';
+            return badge('by','🆕',`${p.lastCommentBy} ${p.lastCommentAgo}${t}`);
+          }
+          if(p.commentState==='HasComments'||p.openThreads>0)return badge('bx','💬',p.openThreads>0?`${p.openThreads} threads`:' ');
+          return '';
+        }
+        function mergeBadge(s){
+          if(s==='Conflict')return badge('br','⚡','conflito');
+          if(s==='BehindBase')return badge('by','↓','desatualizado');
+          return '';
+        }
+        function renderMyPr(p){
+          const cls=(uc[p.urgency]||'')+(p.isDraft?' draft':'');
+          const draft=p.isDraft?badge('bx','','rascunho'):'';
+          return `<div class="pr ${cls}">
+            <div class="ptitle"><span class="pnum">#${p.number}</span><a href="${e(p.url)}" target="_blank" rel="noopener">${e(p.title)}</a></div>
+            <div class="pmeta">${draft}${reviewBadge(p)}${ciBadge(p.ciState,p.failingCheck)}${commentBadge(p)}${mergeBadge(p.mergeState)}<span>${e(p.ageAgo)}</span></div>
+          </div>`;
+        }
+        function renderMyPrs(prs){
+          const s=document.getElementById('s-my');
+          if(!prs.length){s.innerHTML='<div class="stitle">Meus PRs Abertos</div><div class="empty">Nenhum PR aberto.</div>';return}
+          const groups={};
+          for(const p of prs)(groups[p.repo]=groups[p.repo]||[]).push(p);
+          let h='<div class="stitle">Meus PRs Abertos</div>';
+          for(const[repo,list]of Object.entries(groups).sort()){
+            h+=`<div class="rgroup"><div class="rlabel">${e(repo)}</div>${list.map(renderMyPr).join('')}</div>`;
+          }
+          s.innerHTML=h;
+        }
+        function renderReviews(prs){
+          const s=document.getElementById('s-rev');
+          if(!prs.length){s.innerHTML='';return}
+          let h='<div class="stitle">Reviews Pedidos a Mim</div>';
+          for(const p of prs){
+            const ci=ciBadge(p.ciState,p.failingCheck);
+            const cmt=p.lastCommentBy?badge('bx','💬',`${p.lastCommentBy} · ${p.lastCommentAgo}`):'';
+            h+=`<div class="pr">
+              <div class="ptitle"><span class="pnum">#${p.number}</span><a href="${e(p.url)}" target="_blank" rel="noopener">${e(p.title)}</a></div>
+              <div class="pmeta"><span class="bx b">${e(p.author)}</span>${ci}${cmt}<span>${e(p.ageAgo)}</span><span style="color:var(--blue);font-size:11px">${e(p.repo)}</span></div>
+            </div>`;
+          }
+          s.innerHTML=h;
+        }
+        function renderMerged(prs){
+          const s=document.getElementById('s-mrg');
+          if(!prs.length){s.innerHTML='';return}
+          let h='<div class="stitle">Mergeados Recentemente</div><div class="scard">';
+          for(const p of prs)h+=`<div class="mrow"><div class="mrepo">${e(p.repo)}</div><div><a href="${e(p.url)}" target="_blank" rel="noopener">#${p.number} ${e(p.title)}</a></div><div class="mmeta">${e(p.mergedAgo)} · levou ${e(p.duration)}</div></div>`;
+          s.innerHTML=h+'</div>';
+        }
+        function render(data){
+          const dot=document.getElementById('dot');
+          const err=document.getElementById('err');
+          if(data.isLoading){dot.className='dot loading';return}
+          dot.className='dot';
+          document.getElementById('loading').style.display='none';
+          document.getElementById('content').style.display='';
+          const na=data.myPrs.filter(p=>p.needsAction).length;
+          document.getElementById('counts').textContent=`${data.myPrs.length} abertos${na?`, ${na} precisam de ação`:''}`;
+          if(data.error){err.style.display='';err.textContent='Erro: '+data.error}else{err.style.display='none'}
+          renderMyPrs(data.myPrs);
+          renderReviews(data.reviewPrs);
+          renderMerged(data.mergedPrs);
+          ivSecs=data.intervalSeconds||300;
+          startCd();
+        }
+        function startCd(){clearTimeout(tmr);cd=ivSecs;tick()}
+        function tick(){
+          const l=document.getElementById('rlabel');
+          if(cd>0){l.textContent=`próximo refresh em ${cd}s`;cd--;tmr=setTimeout(tick,1000)}
+          else{l.textContent='atualizando...';go()}
+        }
+        async function go(){
+          const dot=document.getElementById('dot');
+          try{
+            const r=await fetch('/api/prs');
+            if(!r.ok)throw new Error('HTTP '+r.status);
+            render(await r.json());
+          }catch(ex){
+            dot.className='dot error';
+            const err=document.getElementById('err');
+            err.style.display='';err.textContent='Falha na conexão: '+ex.message;
+            startCd();
+          }
+        }
+        function manual(){clearTimeout(tmr);document.getElementById('rlabel').textContent='atualizando...';go()}
+        go();
+        </script>
+        </body>
+        </html>
+        """;
+}
