<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PrDashboard</AssemblyName>
    <ApplicationIcon>..\github.ico</ApplicationIcon>

    <!-- Windows file properties (visible in Explorer → Properties → Details) -->
    <Product>PrDashboard</Product>
    <AssemblyTitle>PrDashboard</AssemblyTitle>
    <Description>Local web UI for tracking GitHub pull requests, reviews and CI status</Description>
    <Company>Matheus Boldrini</Company>
    <Copyright>© 2026 Matheus Boldrini</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Version is overridden by CI via -p:Version / -p:FileVersion / -p:AssemblyVersion -->
    <Version>0.0.1</Version>
    <FileVersion>0.0.1.0</FileVersion>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="message.mp3" Condition="Exists('message.mp3')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="error.mp3" Condition="Exists('error.mp3')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="github.svg" Condition="Exists('github.svg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
