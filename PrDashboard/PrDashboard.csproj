<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PrDashboard</AssemblyName>
    <ApplicationIcon>..\github.ico</ApplicationIcon>

    <!-- Windows file properties (visible in Explorer → Properties → Details) -->
    <Product>PrDashboard</Product>
    <AssemblyTitle>PrDashboard</AssemblyTitle>
    <Description>Local web UI for tracking GitHub pull requests, reviews and CI status</Description>
    <Company>Matheus Boldrini</Company>
    <Copyright>© 2026 Matheus Boldrini</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Version is overridden by CI via -p:Version / -p:FileVersion / -p:AssemblyVersion -->
    <Version>0.0.1</Version>
    <FileVersion>0.0.1.0</FileVersion>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>

    <!-- Single-file: include native DLLs (WebView2Loader.dll, etc.) no bundle -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="github.ico" LogicalName="PrDashboard.github.ico" />
    <EmbeddedResource Include="Web\index.html" />
    <EmbeddedResource Include="Web\app.css" />
    <EmbeddedResource Include="Web\app.js" />
    <EmbeddedResource Include="Web\icons.svg" />

    <!-- Modular structure - CSS -->
    <EmbeddedResource Include="Web\css\custom.css" />

    <!-- Modular structure - Core JS -->
    <EmbeddedResource Include="Web\js\i18n.js" />
    <EmbeddedResource Include="Web\js\api.js" />
    <EmbeddedResource Include="Web\js\config.js" />
    <EmbeddedResource Include="Web\js\viewLoader.js" />

    <!-- Modular structure - Components -->
    <EmbeddedResource Include="Web\js\components\toast.js" />
    <EmbeddedResource Include="Web\js\components\modal.js" />
    <EmbeddedResource Include="Web\js\components\dropdown.js" />

    <!-- Modular structure - Views JS -->
    <EmbeddedResource Include="Web\js\views\dashboard.js" />
    <EmbeddedResource Include="Web\js\views\statistics.js" />

    <!-- Modular structure - Views HTML -->
    <EmbeddedResource Include="Web\views\dashboard.html" />
    <EmbeddedResource Include="Web\views\statistics.html" />
    <EmbeddedResource Include="Web\views\worktrees.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Incluir config.default.json no build -->
    <None Update="config.default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="message.mp3" Condition="Exists('message.mp3')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="error.mp3" Condition="Exists('error.mp3')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="done.mp3" Condition="Exists('done.mp3')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="github.svg" Condition="Exists('github.svg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Target customizado: copiar default apenas se config.json não existir ou se estiver em CI -->
  <Target Name="EnsureConfigFile" AfterTargets="AfterBuild">
    <PropertyGroup>
      <IsCI Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true'">true</IsCI>
      <ConfigPath>$(OutDir)config.json</ConfigPath>
      <ConfigDefaultPath>$(OutDir)config.default.json</ConfigDefaultPath>
    </PropertyGroup>

    <!-- Se está no CI, sempre copiar (sobrescrever) -->
    <Copy Condition="'$(IsCI)' == 'true'"
          SourceFiles="$(ConfigDefaultPath)"
          DestinationFiles="$(ConfigPath)"
          OverwriteReadOnlyFiles="true" />

    <!-- Se não está no CI e config.json não existe, copiar -->
    <Copy Condition="'$(IsCI)' != 'true' AND !Exists('$(ConfigPath)')"
          SourceFiles="$(ConfigDefaultPath)"
          DestinationFiles="$(ConfigPath)" />

    <Message Condition="'$(IsCI)' == 'true'"
             Text="[CI Build] config.json criado/sobrescrito a partir do default"
             Importance="high" />
    <Message Condition="'$(IsCI)' != 'true' AND !Exists('$(ConfigPath)')"
             Text="[Local Build] config.json criado a partir do default (primeira vez)"
             Importance="high" />
    <Message Condition="'$(IsCI)' != 'true' AND Exists('$(ConfigPath)')"
             Text="[Local Build] config.json existente preservado (não sobrescrito)"
             Importance="high" />
  </Target>

</Project>
